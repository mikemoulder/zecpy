# Every value the examples and tests read. Leave values empty here; put real ones in .env (gitignored).

# Network the examples run against: test | main
ZECPY_NETWORK=
# lightwalletd / Zaino gRPC endpoint, e.g. https://host:443 (testnet endpoint chosen on Day 1, see memory.md)
ZECPY_SERVER=
# 24-word BIP-39 mnemonic for the TESTNET demo wallet. Never a mainnet seed. Never committed.
ZECPY_TEST_MNEMONIC=
# Wallet birthday height for the demo wallet (skip scanning history before it)
ZECPY_BIRTHDAY=
# Optional SOCKS5 proxy for Tor, e.g. socks5h://127.0.0.1:9050 (only if not using built-in arti)
ZECPY_TOR_PROXY=
