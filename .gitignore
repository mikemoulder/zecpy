# Rust build output
target/
**/*.rs.bk

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.whl
build/
wheels/
*.so
*.pyd
.ipynb_checkpoints/

# Wallet state. Never commit a wallet database or anything derived from a seed.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
wallets/
*.seed
*.mnemonic
*.ufvk
*.usk

# Proving parameters (downloaded and cached at runtime)
*.params
params/

# Leak-audit recordings may contain real txids and IPs. Commit only scrubbed fixtures.
audit-logs/

# Environment. NEVER commit these. Commit .env.example instead.
.env
.env.local
.env*.local

# Logs
*.log

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Deliberately NOT ignored:
#   *.md          docs/ is judge-facing evidence (architecture, privacy model,
#                 integrations). Ignoring markdown hides it.

# Third-party Claude skills used for the website live in their own repo
.claude/skills/

# Local continuity notes, excluded from the published repository.
/handoff.md
/memory.md
